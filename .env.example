DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For hosted PostgreSQL, set DATABASE_URL in the hosting provider's environment.
# DATABASE_URL=postgresql://user:password@database-host:5432/anorank?sslmode=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# For SQLite on a persistent server disk, set SQLITE_PATH to the database file.
